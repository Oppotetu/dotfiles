#!/usr/bin/env bash

#
# ~/.bashrc
#

# If not running interactively, don't do anything (leave this at the top of this file)
[[ $- != *i* ]] && return

# eval -- "$(/usr/bin/starship init bash --print-full-init)"

# Load shared shell config
if [ -f "$HOME/.shellrc-shared" ]; then
    . "$HOME/.shellrc-shared"
fi

eval -- "$(/usr/bin/starship init bash --print-full-init)"