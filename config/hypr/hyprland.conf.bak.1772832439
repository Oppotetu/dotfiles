source = ~/.config/hypr/hypr.conf.d/monitors.conf
source = ~/.config/hypr/hypr.conf.d/envs.conf
source = ~/.config/hypr/hypr.conf.d/autostart.conf
source = ~/.config/hypr/hypr.conf.d/permissions.conf
source = ~/.config/hypr/hypr.conf.d/lookAndFeel.conf
