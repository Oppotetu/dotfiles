// Place your key bindings in this file to override the defaultsauto[]
[
  {
    "key": "ctrl+alt+n",
    "command": "python.execInTerminal-icon",
  },
  {
    "key": "ctrl+alt+t",
    "command": "workbench.action.terminal.runSelectedText",
  },
  {
    "key": "ctrl+alt+j",
    "command": "editor.action.joinLines",
  },
  {
    "key": "shift+alt+i",
    "command": "editor.action.formatDocument",
    "when": "editorHasDocumentFormattingProvider && editorTextFocus && !editorReadonly && !inCompositeEditor",
  },
  {
    "key": "shift+alt+f",
    "command": "-editor.action.formatDocument",
    "when": "editorHasDocumentFormattingProvider && editorTextFocus && !editorReadonly && !inCompositeEditor",
  },
  {
    "key": "ctrl+shift+0",
    "command": "workbench.action.nextSideBarView",
  },
  {
    "key": "ctrl+shift+9",
    "command": "workbench.action.previousSideBarView",
  },
  {
    "key": "ctrl+9",
    "command": "-workbench.action.lastEditorInGroup",
  },
  {
    "key": "ctrl+0",
    "command": "-workbench.action.focusSideBar",
  },
  {
    "key": "ctrl+l",
    "command": "-extension.smoothscroll_scrollCenter",
    "when": "editorTextFocus && !suggestWidgetVisible",
  },
  {
    "key": "pagedown",
    "command": "-extension.smoothscroll_cursorDown",
    "when": "editorTextFocus && !suggestWidgetVisible",
  },
  {
    "key": "pageup",
    "command": "-extension.smoothscroll_cursorUp",
    "when": "editorTextFocus && !suggestWidgetVisible",
  },
  {
    "key": "shift+pagedown",
    "command": "-extension.smoothscroll_selectionDown",
    "when": "editorTextFocus && !suggestWidgetVisible",
  },
  {
    "key": "shift+pageup",
    "command": "-extension.smoothscroll_selectionUp",
    "when": "editorTextFocus && !suggestWidgetVisible",
  },
  {
    "key": "ctrl+n",
    "command": "-workbench.action.files.newUntitledFile",
  },
  {
    "key": "ctrl+n",
    "command": "-extension.vim_ctrl+n",
    "when": "editorTextFocus && vim.active && vim.use<C-n> && !inDebugRepl || vim.active && vim.use<C-n> && !inDebugRepl && vim.mode == 'CommandlineInProgress' || vim.active && vim.use<C-n> && !inDebugRepl && vim.mode == 'SearchInProgressMode'",
  },
  {
    "key": "ctrl+n",
    "command": "extension.vim_ctrl+n",
  },
  {
    "key": "ctrl+m",
    "command": "-editor.action.toggleTabFocusMode",
  },
  {
    "key": "ctrl+m",
    "command": "workbench.action.nextEditor",
  },
  {
    "key": "ctrl+pagedown",
    "command": "-workbench.action.nextEditor",
  },
  {
    "key": "ctrl+n",
    "command": "workbench.action.previousEditor",
  },
  {
    "key": "ctrl+pageup",
    "command": "-workbench.action.previousEditor",
  },
  {
    "key": "ctrl+e",
    "command": "-workbench.action.quickOpen",
  },
  {
    "key": "ctrl+e",
    "command": "-editor.action.toggleScreenReaderAccessibilityMode",
    "when": "accessibilityHelpIsShown",
  },
  {
    "key": "alt+e",
    "command": "workbench.action.toggleSidebarVisibility",
  },
  {
    "key": "ctrl+b",
    "command": "-workbench.action.toggleSidebarVisibility",
  },
  {
    "key": "ctrl+shift+p",
    "command": "workbench.action.showCommands",
  },
  {
    "key": "ctrl+shift+p",
    "command": "-workbench.action.showCommands",
  },
  {
    "key": "ctrl+k",
    "command": "workbench.action.focusAboveGroup",
  },
  {
    "key": "ctrl+k ctrl+up",
    "command": "-workbench.action.focusAboveGroup",
  },
  {
    "key": "ctrl+k ctrl+down",
    "command": "-workbench.action.focusBelowGroup",
  },
  {
    "key": "ctrl+h",
    "command": "workbench.action.focusLeftGroup",
  },
  {
    "key": "ctrl+k ctrl+left",
    "command": "-workbench.action.focusLeftGroup",
  },
  {
    "key": "ctrl+l",
    "command": "workbench.action.focusRightGroup",
  },
  {
    "key": "ctrl+k ctrl+right",
    "command": "-workbench.action.focusRightGroup",
  },

  {
    "key": "alt+[Semicolon]",
    "command": "workbench.action.togglePanel",
  },
  {
    "key": "ctrl+j",
    "command": "-workbench.action.togglePanel",
  },
  {
    "key": "ctrl+u",
    "command": "editor.action.copyLinesDownAction",
    "when": "editorTextFocus && !editorReadonly",
  },
  {
    "key": "shift+alt+down",
    "command": "-editor.action.copyLinesDownAction",
    "when": "editorTextFocus && !editorReadonly",
  },
  {
    "key": "ctrl+alt+a",
    "command": "-surround-advanced.surround",
  },
  {
    "key": "ctrl+alt+x",
    "command": "-surround-advanced.remove-surround",
  },
  {
    "key": "ctrl+alt+r",
    "command": "-surround-advanced.replace-surround",
  },
  {
    "key": "ctrl+g",
    "command": "editor.action.addSelectionToNextFindMatch",
    "when": "editorFocus",
  },
  {
    "key": "ctrl+d",
    "command": "-editor.action.addSelectionToNextFindMatch",
    "when": "editorFocus",
  },
  {
    "key": "ctrl+down",
    "command": "-selectNextSuggestion",
    "when": "suggestWidgetMultipleSuggestions && suggestWidgetVisible && textInputFocus || suggestWidgetVisible && textInputFocus && !suggestWidgetHasFocusedSuggestion",
  },
  {
    "key": "ctrl+up",
    "command": "-selectPrevSuggestion",
    "when": "suggestWidgetMultipleSuggestions && suggestWidgetVisible && textInputFocus || suggestWidgetVisible && textInputFocus && !suggestWidgetHasFocusedSuggestion",
  },
  {
    "key": "f4",
    "command": "-search.action.focusNextSearchResult",
    "when": "hasSearchResult || inSearchEditor",
  },
  {
    "key": "shift+f4",
    "command": "-search.action.focusPreviousSearchResult",
    "when": "hasSearchResult || inSearchEditor",
  },
  {
    "key": "alt+j",
    "command": "editor.action.marker.next",
    "when": "editorFocus",
  },
  {
    "key": "alt+f8",
    "command": "-editor.action.marker.next",
    "when": "editorFocus",
  },
  {
    "key": "ctrl+8",
    "command": "-workbench.action.focusEighthEditorGroup",
  },
  {
    "key": "alt+k",
    "command": "editor.action.marker.prev",
    "when": "editorFocus",
  },
  {
    "key": "shift+alt+f8",
    "command": "-editor.action.marker.prev",
    "when": "editorFocus",
  },
  {
    "key": "cmd+j",
    "command": "-workbench.action.togglePanel",
  },
  {
    "key": "ctrl+p",
    "command": "workbench.action.quickOpen",
  },
  {
    "key": "cmd+p",
    "command": "-workbench.action.quickOpen",
  },
  {
    "key": "ctrl+h",
    "command": "-deleteLeft",
    "when": "textInputFocus",
  },
  {
    "key": "ctrl+k",
    "command": "-deleteAllRight",
    "when": "textInputFocus && !editorReadonly",
  },
  {
    "key": "ctrl+j",
    "command": "-editor.action.joinLines",
    "when": "editorTextFocus && !editorReadonly",
  },
  {
    "key": "ctrl+alt+s",
    "command": "editor.action.insertSnippet",
    "when": "editorTextFocus",
    "args": {
      "name": "Import std",
      "langId": "zig",
      "snippet": "const std = @import(\"std\");",
    },
  },
  {
    "key": "ctrl+alt+d",
    "command": "editor.action.insertSnippet",
    "when": "editorTextFocus",
    "args": {
      "name": "Debug print",
      "langId": "zig",
      "snippet": "const debug = std.debug.print;",
    },
  },
  {
    "key": "ctrl+alt+o",
    "command": "editor.action.insertSnippet",
    "when": "editorTextFocus",
    "args": {
      "name": "Print",
      "langId": "zig",
      "snippet": "const print = std.io.getStdOut().writer().print;",
    },
  },
  {
    "key": "ctrl+alt+l",
    "command": "editor.action.insertSnippet",
    "when": "editorTextFocus",
    "args": {
      "name": "Console log",
      "langId": "javascript",
      "snippet": "console.log('${1:${TM_SELECTED_TEXT}}: ', ${1:${TM_SELECTED_TEXT}});",
    },
  },
  {
    "key": "ctrl+alt+o",
    "command": "editor.action.insertSnippet",
    "when": "editorTextFocus",
    "args": {
      "name": "Console log only string",
      "langId": "javascript",
      "snippet": "console.log('${1:${TM_SELECTED_TEXT}}');",
    },
  },
  {
    "key": "ctrl+alt+k",
    "command": "editor.action.insertSnippet",
    "when": "editorTextFocus",
    "args": {
      "name": "Effect log",
      "langId": "javascriptreact",
      "snippet": "useEffect(() => {\n\tconsole.log('${1:${TM_SELECTED_TEXT}}', ${1:${TM_SELECTED_TEXT}});\n}, [${1:${TM_SELECTED_TEXT}}]);",
    },
  },
  {
    "key": "ctrl+y",
    "command": "-extension.vim_ctrl+y",
    "when": "editorTextFocus && vim.active && vim.use<C-y> && !inDebugRepl",
  },
  {
    "key": "ctrl+y",
    "command": "extension.vim_ctrl+y",
  },
  {
    "key": "ctrl+f",
    "command": "scrollerPower.smallDown",
    "when": "editorTextFocus",
  },
  {
    "key": "ctrl+e",
    "command": "-scrollerPower.smallDown",
    "when": "editorTextFocus",
  },
  {
    "key": "ctrl+s",
    "command": "scrollerPower.smallUp",
    "when": "editorTextFocus",
  },
  {
    "key": "ctrl+y",
    "command": "-scrollerPower.smallUp",
    "when": "editorTextFocus",
  },
  {
    "key": "ctrl+e",
    "command": "scrollerPower.mediumUp",
    "when": "editorTextFocus",
  },
  {
    "key": "ctrl+j",
    "command": "-scrollerPower.mediumUp",
    "when": "editorTextFocus",
  },
  {
    "key": "ctrl+d",
    "command": "-extension.vim_ctrl+d",
    "when": "editorTextFocus && vim.active && vim.use<C-d> && !inDebugRepl",
  },
  {
    "key": "ctrl+cmd+i",
    "command": "-workbench.panel.chat",
    "when": "workbench.panel.chat.view.copilot.active",
  },
  {
    "key": "ctrl+alt+i",
    "command": "workbench.panel.chat",
    "when": "workbench.panel.chat.view.copilot.active",
  },
  {
    "key": "ctrl+cmd+i",
    "command": "-workbench.action.chat.open",
    "when": "!chatSetupDisabled && !chatSetupHidden",
  },
  {
    "key": "ctrl+alt+i",
    "command": "workbench.action.chat.open",
  },
  {
    "key": "ctrl+w",
    "command": "workbench.action.closeActiveEditor",
  },
  {
    "key": "cmd+w",
    "command": "-workbench.action.closeActiveEditor",
  },
  {
    "key": "ctrl+b",
    "command": "workbench.action.reopenClosedEditor",
  },
  {
    "key": "shift+cmd+t",
    "command": "-workbench.action.reopenClosedEditor",
  },
  {
    "key": "ctrl+[Period]",
    "command": "workbench.view.explorer",
    "when": "viewContainer.workbench.view.explorer.enabled",
  },
  {
    "key": "shift+cmd+e",
    "command": "-workbench.view.explorer",
    "when": "viewContainer.workbench.view.explorer.enabled",
  },
  {
    "key": "ctrl+[Comma]",
    "command": "workbench.view.search",
    "when": "workbench.view.search.active && neverMatch =~ /doesNotMatch/",
  },
  {
    "key": "shift+cmd+f",
    "command": "-workbench.view.search",
    "when": "workbench.view.search.active && neverMatch =~ /doesNotMatch/",
  },
  {
    "key": "ctrl+-",
    "command": "workbench.view.extensions",
    "when": "viewContainer.workbench.view.extensions.enabled",
  },
  {
    "key": "shift+cmd+x",
    "command": "-workbench.view.extensions",
    "when": "viewContainer.workbench.view.extensions.enabled",
  },
  {
    "key": "ctrl+j",
    "command": "workbench.action.focusBelowGroup",
  },
  {
    "key": "cmd+k cmd+down",
    "command": "-workbench.action.focusBelowGroup",
  },
  {
    "key": "alt+p",
    "command": "-togglePreserveCase",
    "when": "editorFocus",
  },
  {
    "key": "alt+p",
    "command": "-toggleSearchPreserveCase",
    "when": "searchViewletFocus",
  },
  {
    "key": "alt+i",
    "command": "workbench.action.moveEditorLeftInGroup",
  },
  {
    "key": "ctrl+shift+pageup",
    "command": "-workbench.action.moveEditorLeftInGroup",
  },
  {
    "key": "alt+o",
    "command": "workbench.action.moveEditorRightInGroup",
  },
  {
    "key": "ctrl+shift+pagedown",
    "command": "-workbench.action.moveEditorRightInGroup",
  },
  {
    "key": "ctrl+shift+h",
    "command": "-workbench.action.replaceInFiles",
  },
  {
    "key": "ctrl+shift+l",
    "command": "-editor.action.selectHighlights",
    "when": "editorFocus",
  },
  {
    "key": "ctrl+shift+l",
    "command": "-selectAllSearchEditorMatches",
    "when": "inSearchEditor",
  },
  {
    "key": "ctrl+shift+l",
    "command": "-notebook.selectAllFindMatches",
    "when": "config.notebook.multiCursor.enabled && notebookFindWidgetFocused || config.notebook.multiCursor.enabled && notebookCellEditorFocused && activeEditor == 'workbench.editor.notebook'",
  },
  {
    "key": "alt+y",
    "command": "workbench.action.splitEditorLeft",
  },
  {
    "key": "ctrl+k ctrl+[Equal]",
    "command": "-workbench.action.splitEditorLeft",
  },
  {
    "key": "alt+u",
    "command": "workbench.action.splitEditorRight",
  },
  {
    "key": "ctrl+k ctrl+[Equal]",
    "command": "-workbench.action.splitEditorRight",
  },
  {
    "key": "ctrl+[Semicolon]",
    "command": "workbench.action.terminal.toggleTerminal",
    "when": "terminal.active",
  },
  {
    "key": "ctrl+shift+[Equal]",
    "command": "-workbench.action.terminal.toggleTerminal",
    "when": "terminal.active",
  },
]
