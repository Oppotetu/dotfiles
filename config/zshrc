# Basic environment
export VAULT_ADDR="https://vault.uio.no:8200"

# Homebrew env (keep if you use Homebrew)
eval "$(/opt/homebrew/bin/brew shellenv)"

# NVM
export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"                   # load nvm
[ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion" # nvm completion

# rbenv
export PATH="$HOME/.rbenv/bin:$PATH"
eval "$(rbenv init -)"

# Other PATHs and tool locations
export PATH="$HOME/development/flutter/bin:$PATH"
export PATH="$HOME/.gem/bin:$PATH"
export PATH="/opt/homebrew/opt/postgresql@17/bin:$PATH"

# Compiler / build flags for Postgres (if needed)
export LDFLAGS="-L/opt/homebrew/opt/postgresql@17/lib"
export CPPFLAGS="-I/opt/homebrew/opt/postgresql@17/include"

# AWS behavior
export AWS_REQUEST_CHECKSUM_CALCULATION=when_required
export AWS_RESPONSE_CHECKSUM_VALIDATION=when_required

zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}'

# zsh syntax highlighting (keep if installed independently)
if [ -f /opt/homebrew/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh ]; then
  source /opt/homebrew/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh
fi

# Load shared shell config
if [ -f "$HOME/.shellrc-shared" ]; then
  source "$HOME/.shellrc-shared"
fi

# Your aliases, functions, and customizations go here

eval "$(starship init zsh)"
