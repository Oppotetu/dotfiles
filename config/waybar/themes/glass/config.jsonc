{
  // General Settings
  "layer": "top",
  "margin-top": 0,
  "margin-bottom": 0,
  "margin-left": 0,
  "margin-right": 0,
  "spacing": 0,
  "reload_style_on_change": true,
  // Load Modules
  "include": ["~/.config/waybar/modules.jsonc"],
  // Modules Left
  "modules-left": [
    // "custom/appmenu",
    "hyprland/workspaces",
    //"wlr/taskbar",
    //"group/quicklinks",
    //"custom/nowplaying",
    // "custom/empty",
    "custom/background",
    "custom/background",
    "custom/surface",
    "custom/surface_container",
    "custom/surface_container_high",

    "custom/primary",
    "custom/primary_container",
    "custom/secondary",
    "custom/secondary_container",

    "custom/tertiary",
    "custom/tertiary_container",

    "custom/error",
    "custom/outline",

    "custom/on_surface",
    "custom/on_surface_variant",
    "custom/inverse_surface",
    "custom/surface_bright",
  ],
  // Modules Center
  "modules-center": ["clock", "hyprland/window"],
  // Modules Right
  "modules-right": [
    // "custom/updates",
    "pulseaudio",
    //"backlight",
    "bluetooth",
    "network",
    "battery",
    "group/hardware",
    "group/tools",
    "tray",
  ],
}
