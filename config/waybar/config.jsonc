{
  "layer": "bottom",
  "position": "top",
  "height": 40,
  "margin": "3, 4, 0, 4",
  "modules-left": ["custom/icon", "hyprland/workspaces", "mpris"],
  "modules-center": ["hyprland/window"],
  "modules-right": [
    "idle_inhibitor",
    "memory",
    "cpu",
    "pulseaudio",
    "network",
    "battery",
    "clock",
  ],
  "reload_style_on_change": true,

  "custom/color0": { "format": " 0" },
  "custom/color1": { "format": " 1" },
  "custom/color2": { "format": " 2" },
  "custom/color3": { "format": " 3" },
  "custom/color4": { "format": " 4" },
  "custom/color5": { "format": " 5" },
  "custom/color6": { "format": " 6" },
  "custom/color7": { "format": " 7" },
  "custom/color8": { "format": " 8" },
  "custom/color9": { "format": " 9" },
  "custom/color10": { "format": "10" },
  "custom/color11": { "format": "11" },
  "custom/color12": { "format": "12" },
  "custom/color13": { "format": "13" },
  "custom/color14": { "format": "14" },
  "custom/color15": { "format": "15" },

  "hyprland/workspaces": {
    // "format": "{icon}",
    // "format-icons": {
    //   "1": "一",
    //   "2": "二",
    //   "3": "三",
    //   "4": "四",
    //   "5": "五",
    //   "6": "六",
    //   "7": "七",
    //   "8": "八",
    //   "9": "九",
    //   "10": "十",
    // },
  },

  // "custom/icon": {
  //   "format": "",
  // },

  "mpris": {
    "interval": 1,
    "format": " {player_icon} {title} - {artist}",
    "format-paused": " {status_icon} <i>{title} - {artist}</i>",
    "player-icons": {
      "default": "▶",
    },
    "status-icons": {
      "paused": "⏸",
    },
    "max-length": 20,
    "ignored-players": ["firefox"],
  },

  "hyprland/window": {
    "format": "{title}",
    "separate-outputs": true,
    "icon": true,
    "max-length": 25,
    // "rewrite": {
    //   "(.*) - Google Chrome": "Chrome",
    //   "(.*) - Visual Studio Code": "VS Code",
    //   "(.*) - Wezterm": "Wezterm",
    //   "": "",
    // },
  },

  "clock": {
    "rotate": 0,
    "tooltip-format": "<tt><small>{calendar}</small></tt>",
    "format": " {:%I:%M %p}",
    "format-alt": " {:%a, %b %d}",
    "calendar": {
      "format": {
        "today": "<span color='#ffffff'><b>{}</b></span>",
      },
    },
    "on-click-right": "wezterm start calcurse",
  },

  "battery": {
    "states": {
      "good": 95,
      "warning": 30,
      "critical": 15,
    },
    "format": "{icon} {capacity}%",
    "format-charging": " {capacity}%",
    "format-plugged": " {capacity}%",
    "format-icons": [" ", " ", " ", " ", " "],
    "format-alt": "{time}",
  },

  "network": {
    "format": "{icon} ",
    "format-alt-click": "click-right",
    "format-wifi": "{icon} ",
    "format-disconnected": "{icon} Disconnected",
    "format-icons": {
      "wifi": ["󰖩"],
      "disconnected": ["󰖪"],
    },
    "on-click": "wezterm start nmtui",
    "tooltip-format": "{ifname}: {ipaddr}",
  },

  "pulseaudio": {
    "format": "{icon}{volume}%",
    "format-muted": " ",
    "format-source": " {volume}%",
    "format-source-muted": "",
    "format-icons": {
      "default": [" ", " ", " "],
    },
    "on-click": "pavucontrol",
  },

  "idle_inhibitor": {
    "format": "{icon}",
    "format-icons": {
      "activated": "",
      "deactivated": "",
    },
  },

  "memory": {
    "interval": 30,
    "format": " {used:0.1f}G/{total:0.1f}G",
  },
  "cpu": {
    "interval": 1,
    "format": " {usage}%",
    "format-alt": " {avg_frequency}",
  },
}

// "hyprland/window"

