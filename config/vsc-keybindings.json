// Place your key bindings in this file to override the defaultsauto[]
[
  {
    "key": "ctrl+alt+n",
    "command": "python.execInTerminal-icon"
  },
  {
    "key": "ctrl+alt+t",
    "command": "workbench.action.terminal.runSelectedText"
  },
  {
    "key": "ctrl+alt+j",
    "command": "editor.action.joinLines"
  },
  {
    "key": "shift+alt+i",
    "command": "editor.action.formatDocument",
    "when": "editorHasDocumentFormattingProvider && editorTextFocus && !editorReadonly && !inCompositeEditor"
  },
  {
    "key": "shift+alt+f",
    "command": "-editor.action.formatDocument",
    "when": "editorHasDocumentFormattingProvider && editorTextFocus && !editorReadonly && !inCompositeEditor"
  },
  {
    "key": "ctrl+shift+0",
    "command": "workbench.action.nextSideBarView"
  },
  {
    "key": "ctrl+shift+9",
    "command": "workbench.action.previousSideBarView"
  },
  {
    "key": "ctrl+9",
    "command": "-workbench.action.lastEditorInGroup"
  },
  {
    "key": "ctrl+0",
    "command": "-workbench.action.focusSideBar"
  },
  {
    "key": "ctrl+l",
    "command": "-extension.smoothscroll_scrollCenter",
    "when": "editorTextFocus && !suggestWidgetVisible"
  },
  {
    "key": "pagedown",
    "command": "-extension.smoothscroll_cursorDown",
    "when": "editorTextFocus && !suggestWidgetVisible"
  },
  {
    "key": "pageup",
    "command": "-extension.smoothscroll_cursorUp",
    "when": "editorTextFocus && !suggestWidgetVisible"
  },
  {
    "key": "shift+pagedown",
    "command": "-extension.smoothscroll_selectionDown",
    "when": "editorTextFocus && !suggestWidgetVisible"
  },
  {
    "key": "shift+pageup",
    "command": "-extension.smoothscroll_selectionUp",
    "when": "editorTextFocus && !suggestWidgetVisible"
  },
  {
    "key": "ctrl+n",
    "command": "-workbench.action.files.newUntitledFile"
  },
  {
    "key": "ctrk+m",
    "command": "extension.vim_down",
    "when": "editorTextFocus && vim.active && vim.mode == 'Visual'"
  },
  {
    "key": "ctrl+n",
    "command": "-extension.vim_ctrl+n",
    "when": "editorTextFocus && vim.active && vim.use<C-n> && !inDebugRepl || vim.active && vim.use<C-n> && !inDebugRepl && vim.mode == 'CommandlineInProgress' || vim.active && vim.use<C-n> && !inDebugRepl && vim.mode == 'SearchInProgressMode'"
  },
  {
    "key": "ctrl+n",
    "command": "extension.vim_ctrl+n"
  },
  {
    "key": "ctrl+m",
    "command": "-editor.action.toggleTabFocusMode"
  },
  {
    "key": "ctrl+m",
    "command": "workbench.action.nextEditor"
  },
  {
    "key": "ctrl+pagedown",
    "command": "-workbench.action.nextEditor"
  },
  {
    "key": "ctrl+n",
    "command": "workbench.action.previousEditor"
  },
  {
    "key": "ctrl+pageup",
    "command": "-workbench.action.previousEditor"
  },
  {
    "key": "ctrl+e",
    "command": "-workbench.action.quickOpen"
  },
  {
    "key": "ctrl+e",
    "command": "-editor.action.toggleScreenReaderAccessibilityMode",
    "when": "accessibilityHelpIsShown"
  },
  {
    "key": "alt+e",
    "command": "workbench.action.toggleSidebarVisibility"
  },
  {
    "key": "ctrl+b",
    "command": "-workbench.action.toggleSidebarVisibility"
  },
  {
    "key": "ctrl+p",
    "command": "workbench.action.showCommands"
  },
  {
    "key": "ctrl+shift+p",
    "command": "-workbench.action.showCommands"
  },
  {
    "key": "tab",
    "command": "vim.remap",
    "when": "editorTextFocus && !hasNextTabstop && !inSnippetMode vim.mode == 'Insert' || vim.mode == 'Visual' || vim.mode == 'VisualBlock' || vim.mode == 'VisualLine' || vim.mode == 'Replace' || vim.mode == 'OperatorPending'",
    "args": {
      "after": ["<Esc>"]
    }
  },
  // {
  //   "key": "ctrl+s",
  //   "command": "vim.remap",
  //   "when": "editorTextFocus && vim.mode == 'Normal' || vim.mode == 'Visual'",
  //   "args": {
  //     "after": ["<C-y>", "<C-y>", "<C-y>"]
  //   }
  // },
  // {
  //   "key": "ctrl+f",
  //   "command": "vim.remap",
  //   "when": "editorTextFocus && vim.mode == 'Normal' || vim.mode == 'Visual'",
  //   "args": {
  //     "after": ["<C-e>", "<C-e>", "<C-e>"]
  //   }
  // },
  // {
  //   "key": "ctrl+e",
  //   "command": "vim.remap",
  //   "when": "editorTextFocus && vim.mode == 'Normal' || vim.mode == 'Visual'",
  //   "args": {
  //     "after": ["<C-u>"]
  //   }
  // },
  {
    "key": "alt+k",
    "command": "workbench.action.focusAboveGroup"
  },
  {
    "key": "ctrl+k ctrl+up",
    "command": "-workbench.action.focusAboveGroup"
  },
  {
    "key": "alt+j",
    "command": "workbench.action.focusBelowGroup"
  },
  {
    "key": "ctrl+k ctrl+down",
    "command": "-workbench.action.focusBelowGroup"
  },
  {
    "key": "alt+h",
    "command": "workbench.action.focusLeftGroup"
  },
  {
    "key": "ctrl+k ctrl+left",
    "command": "-workbench.action.focusLeftGroup"
  },
  {
    "key": "alt+l",
    "command": "workbench.action.focusRightGroup"
  },
  {
    "key": "ctrl+k ctrl+right",
    "command": "-workbench.action.focusRightGroup"
  },

  {
    "key": "alt+oem_3",
    "command": "workbench.action.togglePanel"
  },
  {
    "key": "ctrl+j",
    "command": "-workbench.action.togglePanel"
  },
  {
    "key": "ctrl+u",
    "command": "editor.action.copyLinesDownAction",
    "when": "editorTextFocus && !editorReadonly"
  },
  {
    "key": "shift+alt+down",
    "command": "-editor.action.copyLinesDownAction",
    "when": "editorTextFocus && !editorReadonly"
  },
  {
    "key": "ctrl+alt+a",
    "command": "-surround-advanced.surround"
  },
  {
    "key": "ctrl+alt+x",
    "command": "-surround-advanced.remove-surround"
  },
  {
    "key": "ctrl+alt+r",
    "command": "-surround-advanced.replace-surround"
  },
  {
    "key": "ctrl+d",
    "command": "workbench.action.quickOpenNavigateNext",
    "when": "inQuickOpen"
  },
  {
    "key": "ctrl+e",
    "command": "workbench.action.quickOpenNavigatePrevious",
    "when": "inQuickOpen"
  },
  {
    "key": "ctrl+g",
    "command": "editor.action.addSelectionToNextFindMatch",
    "when": "editorFocus"
  },
  {
    "key": "ctrl+d",
    "command": "-editor.action.addSelectionToNextFindMatch",
    "when": "editorFocus"
  },
  {
    "key": "ctrl+d",
    "command": "selectNextSuggestion",
    "when": "suggestWidgetMultipleSuggestions && suggestWidgetVisible && textInputFocus || suggestWidgetVisible && textInputFocus && !suggestWidgetHasFocusedSuggestion"
  },
  {
    "key": "ctrl+down",
    "command": "-selectNextSuggestion",
    "when": "suggestWidgetMultipleSuggestions && suggestWidgetVisible && textInputFocus || suggestWidgetVisible && textInputFocus && !suggestWidgetHasFocusedSuggestion"
  },
  {
    "key": "ctrl+e",
    "command": "selectPrevSuggestion",
    "when": "suggestWidgetMultipleSuggestions && suggestWidgetVisible && textInputFocus || suggestWidgetVisible && textInputFocus && !suggestWidgetHasFocusedSuggestion"
  },
  {
    "key": "ctrl+up",
    "command": "-selectPrevSuggestion",
    "when": "suggestWidgetMultipleSuggestions && suggestWidgetVisible && textInputFocus || suggestWidgetVisible && textInputFocus && !suggestWidgetHasFocusedSuggestion"
  },
  {
    "key": "ctrl+d",
    "command": "search.action.focusNextSearchResult",
    "when": "inSearchEditor && searchViewletFocus"
  },
  {
    "key": "f4",
    "command": "-search.action.focusNextSearchResult",
    "when": "hasSearchResult || inSearchEditor"
  },
  {
    "key": "ctrl+e",
    "command": "search.action.focusPreviousSearchResult",
    "when": "inSearchEditor && searchViewletFocus"
  },
  {
    "key": "shift+f4",
    "command": "-search.action.focusPreviousSearchResult",
    "when": "hasSearchResult || inSearchEditor"
  },
  {
    "key": "ctrl+9",
    "command": "editor.action.marker.next",
    "when": "editorFocus"
  },
  {
    "key": "alt+f8",
    "command": "-editor.action.marker.next",
    "when": "editorFocus"
  },
  {
    "key": "ctrl+8",
    "command": "-workbench.action.focusEighthEditorGroup"
  },
  {
    "key": "ctrl+8",
    "command": "editor.action.marker.prev",
    "when": "editorFocus"
  },
  {
    "key": "shift+alt+f8",
    "command": "-editor.action.marker.prev",
    "when": "editorFocus"
  },
  {
    "key": "alt+p",
    "command": "workbench.action.quickOpen"
  },
  {
    "key": "ctrl+p",
    "command": "-workbench.action.quickOpen"
  },

  {
    "key": "tab",
    "command": "jumpToNextSnippetPlaceholder",
    "when": "hasNextTabstop && inSnippetMode && textInputFocus"
  },
  {
    "key": "shift+tab",
    "command": "jumpToPrevSnippetPlaceholder",
    "when": "editorTextFocus && hasSnippetTabstop"
  },
  {
    "key": "ctrl+alt+l",
    "command": "editor.action.insertSnippet",
    "when": "editorTextFocus",
    "args": {
      "name": "Console log",
      "langId": "javascript",
      "snippet": "console.log('${2:${TM_SELECTED_TEXT}}', ${1:${TM_SELECTED_TEXT}});"
    }
  },
  {
    "key": "ctrl+alt+k",
    "command": "editor.action.insertSnippet",
    "when": "editorTextFocus",
    "args": {
      "name": "Effect log",
      "langId": "javascriptreact",
      "snippet": "React.useEffect(() => {\n\tconsole.log('${2:${TM_SELECTED_TEXT}}', ${1:${TM_SELECTED_TEXT}});\n}, [${1:${TM_SELECTED_TEXT}}]);"
    }
  },
  {
    "key": "ctrl+alt+s",
    "command": "editor.action.insertSnippet",
    "when": "editorTextFocus",
    "args": {
      "name": "Import std",
      "langId": "zig",
      "snippet": "const std = @import(\"std\");"
    }
  },
  {
    "key": "ctrl+alt+d",
    "command": "editor.action.insertSnippet",
    "when": "editorTextFocus",
    "args": {
      "name": "Debug print",
      "langId": "zig",
      "snippet": "const debug = std.debug.print;"
    }
  },
  {
    "key": "ctrl+alt+p",
    "command": "editor.action.insertSnippet",
    "when": "editorTextFocus",
    "args": {
      "name": "Print",
      "langId": "zig",
      "snippet": "const print = std.io.getStdOut().writer().print;"
    }
  },
  {
    "key": "ctrl+e",
    "command": "-extension.vim_ctrl+e",
    "when": "editorTextFocus && vim.active && vim.use<C-e> && !inDebugRepl"
  },
  {
    "key": "ctrl+f",
    "command": "scrollerPower.smallDown",
    "when": "editorTextFocus"
  },
  {
    "key": "ctrl+e",
    "command": "-scrollerPower.smallDown",
    "when": "editorTextFocus"
  },
  {
    "key": "ctrl+e",
    "command": "scrollerPower.mediumUp",
    "when": "editorTextFocus"
  },
  {
    "key": "ctrl+j",
    "command": "-scrollerPower.mediumUp",
    "when": "editorTextFocus"
  },
  {
    "key": "ctrl+s",
    "command": "scrollerPower.smallUp",
    "when": "editorTextFocus"
  },
  {
    "key": "ctrl+y",
    "command": "-scrollerPower.smallUp",
    "when": "editorTextFocus"
  },
  {
    "key": "ctrl+d",
    "command": "-extension.vim_ctrl+d",
    "when": "editorTextFocus && vim.active && vim.use<C-d> && !inDebugRepl"
  }
]