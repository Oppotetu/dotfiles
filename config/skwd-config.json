{
  "compositor": "hyprland",
  "monitor": "",
  "general": {
    "locale": "",
    "closeOnSelection": false,
    "reopenAtLastSelection": false
  },
  "paths": {
    "wallpaper": "~/Pictures/wallpapers",
    "videoWallpaper": "~/videowalls",
    "cache": "",
    "templates": "",
    "scripts": "",
    "steam": "",
    "steamWorkshop": "",
    "steamWeAssets": ""
  },
  "features": {
    "matugen": true,
    "ollama": false,
    "steam": false,
    "wallhaven": true
  },
  "colorSource": "magick",
  "ollama": {
    "url": "http://localhost:11434",
    "model": "gemma3:4b",
    "consolidateEnabled": true
  },
  "steam": {
    "apiKey": "",
    "username": ""
  },
  "wallhaven": {
    "apiKey": ""
  },
  "matugen": {
    "schemeType": "scheme-fidelity",
    "mode": "dark"
  },
  "integrations": [
    {
      "_comment": "Built-in: MD3 colors for the shell UI (always needed)",
      "name": "skwd-wall",
      "template": "quickshell-colors.json",
      "output": "colors.json"
    },
    {
      "_comment": "MD3 colors for the Skwd shell widgets (skwd-bar etc)",
      "name": "skwd",
      "template": "quickshell-colors.json",
      "output": "~/.cache/skwd/colors.json"
    },
    {
      "name": "qt6ct",
      "template": "qt6ct-colors.conf",
      "output": "~/.config/qt6ct/colors/matugen.conf"
    },
    {
      "name": "colors",
      "template": "~/.config/matugen/templates/colors.css",
      "output": "~/.config/current/theme/colors.css",
      "reload": "pkill -SIGUSR2 waybar && swaync-client -rs"
    },
    {
      "name": "wallpaper",
      "template": "~/.config/matugen/templates/wallpaper.txt",
      "output": "~/.config/current/theme/wallpaper.txt",
      "reload": "~/.local/bin/sync-current-wallpaper.sh"
    },
    {
      "name": "btop",
      "template": "~/.config/matugen/templates/btop.theme",
      "output": "~/.config/btop/themes/matugen.theme",
      "reload": "(pgrep btop && pkill -USR2 btop) || true"
    },
    {
      "name": "hyprland",
      "template": "~/.config/matugen/templates/hyprland.conf",
      "output": "~/.config/hypr/colors.conf",
      "reload": "hyprctl reload"
    },
    {
      "name": "chromium",
      "template": "~/.config/matugen/templates/chromium.theme",
      "output": "~/.config/current/theme/chromium.theme",
      "reload": "~/.local/bin/chromium-set-theme.sh && ~/.local/bin/chromium-set-background.sh"
    },
    {
      "name": "starship",
      "template": "~/.config/matugen/templates/starship.toml",
      "output": "~/.config/starship.toml",
      "reload": "source ~/.bashrc"
    },
    {
      "name": "gazelle",
      "template": "~/.config/matugen/templates/gazelle.toml",
      "output": "~/.config/gazelle/theme.toml"
    },
    {
      "name": "spotify-player",
      "template": "~/.config/matugen/templates/spotify-player.toml",
      "output": "~/.config/spotify-player/theme.toml"
    },
    {
      "name": "vscode",
      "template": "~/.config/matugen/templates/vscode.json",
      "output": "~/.cache/wallust/colors.json"
    },
    {
      "name": "vscode2",
      "template": "~/.config/matugen/templates/vscode",
      "output": "~/.cache/wallust/colors"
    },
    {
      "name": "godot",
      "template": "~/.config/matugen/templates/godot-colors.theme",
      "output": "~/.config/godot/colors.sh",
      "reload": "~/.config/godot/colors-apply.sh"
    },
    {
      "name": "fuzzel",
      "template": "~/.config/matugen/templates/fuzzel.ini",
      "output": "~/.config/fuzzel/fuzzel-colors.ini"
    },
    {
      "name": "wezterm",
      "template": "~/.config/matugen/templates/wezterm.lua",
      "output": "~/.config/wezterm/wezterm-colors.lua"
    },
    {
      "name": "gtk3",
      "template": "~/.config/matugen/templates/gtk-3.0.css",
      "output": "~/.config/gtk-3.0/gtk.css"
    },
    {
      "name": "gtk4",
      "template": "~/.config/matugen/templates/gtk-4.0.css",
      "output": "~/.config/gtk-4.0/gtk.css"
    }
  ],
  "components": {
    "wallpaperSelector": {
      "displayMode": "wall",
      "sliceSpacing": -30,
      "hexScrollStep": 1,
      "customPresets": {}
    }
  },
  "wallpaperMute": true,
  "pickOnlyMode": false,
  "externalWallpaperCommand": "",
  "postProcessing": [],
  "performance": {
    "imageOptimizePreset": "balanced",
    "imageOptimizeResolution": "2k",
    "videoConvertPreset": "balanced",
    "videoConvertResolution": "2k",
    "autoOptimizeImages": false,
    "autoConvertVideos": false,
    "imageTrashDays": 7,
    "videoTrashDays": 7,
    "autoDeleteImageTrash": false,
    "autoDeleteVideoTrash": false
  }
}
