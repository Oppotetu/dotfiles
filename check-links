#!/usr/bin/env bash
set -euo pipefail

PROFILE="${1:-}"
MODE="${2:-check}" # check | fix

BASE_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

META_DIR="meta"
CONFIG_DIR="yamlfiles"
PROFILES_DIR="profiles"
CONFIG_SUFFIX=".yaml"

if [[ -z "$PROFILE" ]]; then
    echo "Usage: $0 <profile> [check|fix]"
    exit 1
fi

PROFILE_FILE="${BASE_DIR}/${META_DIR}/${PROFILES_DIR}/${PROFILE}"

if [[ ! -f "$PROFILE_FILE" ]]; then
    echo "Profile not found: $PROFILE_FILE"
    exit 1
fi

broken=0

while IFS= read -r config; do
    [[ -z "$config" ]] && continue

    suffix="-sudo"
    yaml="${BASE_DIR}/${META_DIR}/${CONFIG_DIR}/${config%"$suffix"}${CONFIG_SUFFIX}"
    [[ ! -f "$yaml" ]] && continue

    echo "→ $config"

    # Extract link entries as: target | condition | source
    while IFS="|" read -r target cond src; do
        target="${target/#\~/$HOME}"
        src="${BASE_DIR}/${src}"

        # Evaluate Dotbot condition
        if [[ -n "$cond" ]]; then
            if ! eval "$cond" >/dev/null 2>&1; then
                continue
            fi
        fi

        if [[ ! -e "$target" ]]; then
            echo "  ❌ missing: $target"
            broken=1
            continue
        fi

        if [[ ! -L "$target" ]]; then
            echo "  ⚠ not a symlink: $target"
            broken=1

            if [[ "$MODE" == "fix" ]]; then
                echo "    ↪ restoring symlink → $src"
                rm -rf "$target"
                ln -s "$src" "$target"
            fi
        fi
    done < <(
        yq -r '
        .[] |
        select(has("link")) |
        .link |
        to_entries[] |
        .key as $target |
        (
        if (.value | type) == "string" then
            "\($target)||\(.value)"
        else
            "\($target)|\(.value.if // "")|\(.value.path)"
        end
        )
    ' "$yaml"
    )

    echo
done <"$PROFILE_FILE"

if [[ "$broken" -eq 0 ]]; then
    echo "✅ All links are intact"
else
    echo "⚠ Broken links detected"
    [[ "$MODE" == "check" ]] && echo "Run with 'fix' to restore"
fi
